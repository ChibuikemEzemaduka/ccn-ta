# =============================================================================
#  CCN AI Teaching Assistant — environment configuration TEMPLATE
# -----------------------------------------------------------------------------
#  Copy this file to ".env" in the project root and fill in the real values:
#
#      cp .env.example .env
#      nano .env
#
#  The real ".env" file is git-ignored and must NEVER be committed. It holds
#  the only secrets the module uses.
# =============================================================================

# Ollama Cloud API key (needed only when USE_CLOUD = True in llm_client.py).
# Create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=paste-your-ollama-cloud-key-here

# Password that protects the Teaching Staff dashboard. Choose a strong value.
INSTRUCTOR_PASSWORD=choose-a-strong-password
