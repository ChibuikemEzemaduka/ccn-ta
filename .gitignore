# =============================================================================
#  CCN AI Teaching Assistant — .gitignore
#  Files listed here are NEVER committed. They hold secrets, student data, or
#  machine-specific/generated content. See README.md for what to recreate after
#  cloning.
# =============================================================================

# ── Secrets — NEVER commit ──────────────────────────────────────────────────
.env
.env.local
.env.bak-*
*.key
*.pem
*.crt
*.cer

# ── Student & teaching-staff data (FERPA-sensitive) ─────────────────────────
students.json
teaching_staff.json
tickets.json
student_replies.json
public_board.json
interactions.json
sessions.json
feedback.json

# ── Course content & generated indexes (large / not code) ───────────────────
materials/
chroma_db/
generated/
knowledge.json
solutions.json
assignments.json
parse_cache.json
homework_parse_cache.json

# ── Generated document exports ──────────────────────────────────────────────
*.docx
*.pptx
*.pdf

# ── Python environment & caches ─────────────────────────────────────────────
venv/
venv-desktop/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── OS / editor noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
